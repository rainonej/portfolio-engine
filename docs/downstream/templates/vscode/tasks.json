{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Upgrade portfolio-engine packages",
      "detail": "Upgrade all @portfolio-engine/* dependencies to their latest published version (DIST_TAG=next for pre-release)",
      "type": "shell",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/docs/downstream/scripts/upgrade-portfolio-engine.ps1"
        ]
      },
      "linux": {
        "command": "bash",
        "args": [
          "${workspaceFolder}/docs/downstream/scripts/upgrade-portfolio-engine.sh"
        ]
      },
      "osx": {
        "command": "bash",
        "args": [
          "${workspaceFolder}/docs/downstream/scripts/upgrade-portfolio-engine.sh"
        ]
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      }
    }
  ]
}

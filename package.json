{
  "name": "portfolio-engine",
  "private": true,
  "description": "Monorepo root for the @portfolio-engine/* packages",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r run dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check \"**/*.{md,json,yml,yaml,mjs}\" --ignore-path .prettierignore",
    "format:write": "prettier --write \"**/*.{md,json,yml,yaml,mjs}\" --ignore-path .prettierignore",
    "check": "pnpm --filter \"./packages/*\" run build && pnpm -r run check && pnpm run check:tokens",
    "check:tokens": "node scripts/check-tokens.mjs",
    "smoke:packed": "node scripts/smoke-packed-consumer.mjs",
    "pe:doctor": "node packages/engine-core/dist/doctor.js",
    "release": "changeset publish"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@eslint/js": "^9.17.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "marked": "^15",
    "prettier": "^3.4.2",
    "tsup": "^8.3.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.19.0"
  },
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=10.0.0"
  }
}

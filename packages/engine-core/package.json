{
  "name": "@portfolio-engine/engine-core",
  "version": "0.1.2",
  "description": "Route registry, config loader, virtual modules, and override resolution for portfolio-engine",
  "type": "module",
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts"
    }
  },
  "scripts": {
    "build": "tsup && node ./scripts/copy-client-dts.mjs",
    "dev": "tsup --watch",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@portfolio-engine/schema": "workspace:*",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "astro": "^6.0.0"
  },
  "devDependencies": {
    "astro": "^6.2.2",
    "typescript": "^6.0.0"
  }
}

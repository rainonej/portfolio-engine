---
import type { ProfilePerson } from '../lib/profile-person.js';

interface Props {
  person: Pick<ProfilePerson, 'linkedin' | 'github' | 'instagram'>;
  label?: string;
  class?: string;
}

const { person, label = 'Social profiles', class: className } = Astro.props;

const links = [
  person.linkedin ? { network: 'linkedin', label: 'LinkedIn', href: person.linkedin } : null,
  person.github ? { network: 'github', label: 'GitHub', href: person.github } : null,
  person.instagram ? { network: 'instagram', label: 'Instagram', href: person.instagram } : null,
].filter((link): link is NonNullable<typeof link> => link !== null);
---

{
  links.length > 0 && (
    <nav aria-label={label} class:list={['pe-social-links', className]}>
      {links.map((link) => (
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          class="pe-social-link"
          aria-label={`Visit ${link.label} profile`}
          title={link.label}
        >
          {link.network === 'linkedin' && (
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
              <path d="M6.5 8.25H3V21h3.5V8.25ZM4.75 3A2.03 2.03 0 1 0 4.75 7.06 2.03 2.03 0 0 0 4.75 3ZM21 13.69c0-3.84-2.05-5.63-4.79-5.63-2.21 0-3.2 1.21-3.75 2.07V8.25H9V21h3.46v-6.31c0-1.66.31-3.27 2.37-3.27 2.03 0 2.06 1.9 2.06 3.38V21H21v-7.31Z" />
            </svg>
          )}
          {link.network === 'github' && (
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor">
              <path fill-rule="evenodd" d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.88c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.35 1.09 2.92.83.09-.65.35-1.09.64-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.58 9.58 0 0 1 12 6.82c.85 0 1.71.12 2.51.34 1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.86v2.76c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" clip-rule="evenodd" />
            </svg>
          )}
          {link.network === 'instagram' && (
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
            </svg>
          )}
        </a>
      ))}
    </nav>
  )
}

---
import Override from '@portfolio-engine:override/FeaturedWriting';
import Reveal from '../Reveal.astro';
import SectionIntro from '../SectionIntro.astro';
import WritingList from '../WritingList.astro';

interface Post {
  id: string;
  title: string;
  date: Date;
  description?: string;
  image?: string;
  href: string;
}

interface Props {
  posts: Post[];
  base: string;
}

const { posts, base } = Astro.props;
---

{Override ? (
  <Override posts={posts} base={base} />
) : (
  <Reveal
    as="section"
    class="border-t border-[var(--color-border-default)] bg-[var(--color-surface-elevated)] px-6 py-24"
    delay={60}
  >
    <div class="mx-auto max-w-3xl">
      <SectionIntro
        eyebrow="Writing"
        heading="Recent Writing"
        allHref={`${base}/writing`}
        allLabel="All posts →"
      />
      <WritingList
        posts={posts.map((post) => ({
          id: post.id,
          title: post.title,
          date: post.date,
          description: post.description,
          image: post.image,
          href: post.href,
        }))}
      />
    </div>
  </Reveal>
)}

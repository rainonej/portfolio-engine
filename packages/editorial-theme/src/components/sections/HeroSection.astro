---
import Override from '@portfolio-engine:override/Hero';
import Reveal from '../Reveal.astro';
import SectionIntro from '../SectionIntro.astro';
import FeaturePillars from '../FeaturePillars.astro';
import { resolveAssetUrl } from '../../lib/utils';
import { resolveHeroBio } from '../../lib/load-profile-person';

interface Pillar {
  heading: string;
  body: string;
  image?: string;
}

interface Person {
  name: string;
  bio?: string;
  shortBio?: string;
  summary?: string;
  longBio?: string[];
  photo?: string;
}

/** Structured CTA entry for the hero. */
interface HeroCta {
  label: string;
  href: string;
  /** Rendering tier: 'primary' = solid button, 'secondary' = outline button, 'link' = plain text link. */
  variant?: 'primary' | 'secondary' | 'link';
  priority?: number;
}

interface Props {
  person: Person;
  bookingUrl: string | null;
  pillars: Pillar[];
  base: string;
  tagline?: string;
  /** Structured CTA list. When provided, renders up to 2 button-style CTAs and the rest as links. */
  ctas?: HeroCta[];
}

const { person, bookingUrl, pillars, base, tagline, ctas } = Astro.props;

const heroBio = resolveHeroBio(person);

/**
 * Build the effective CTA list from either the structured `ctas` prop or the legacy
 * `bookingUrl` + hard-coded "Explore my work" approach. At most 2 button-style CTAs
 * are rendered; additional items become plain text links.
 */
const effectiveCtas: HeroCta[] = (() => {
  if (ctas && ctas.length > 0) {
    return [...ctas].sort((a, b) => (a.priority ?? 0) - (b.priority ?? 0));
  }
  const defaultCtas: HeroCta[] = [
    { label: 'Explore my work', href: `${base}/work`, variant: 'primary', priority: 1 },
  ];
  if (bookingUrl) {
    defaultCtas.push({ label: 'Book a conversation', href: bookingUrl, variant: 'secondary', priority: 2 });
  }
  return defaultCtas;
})();

// Separate button-style CTAs (primary/secondary) from link-style ones
const buttonCtas = effectiveCtas.filter((c) => c.variant !== 'link').slice(0, 2);
const linkCtas = [
  ...effectiveCtas.filter((c) => c.variant !== 'link').slice(2),
  ...effectiveCtas.filter((c) => c.variant === 'link'),
];

const isDev = import.meta.env.DEV;
if (isDev && effectiveCtas.length > 3) {
  console.warn(
    `[editorial-theme] HeroSection has ${effectiveCtas.length} CTAs. Recommend no more than 3 to avoid decision overload.`,
  );
}
---

{Override ? (
  <Override person={person} bookingUrl={bookingUrl} pillars={pillars} base={base} tagline={tagline} />
) : (
  <>
    <!-- Hero -->
    <section class="mx-auto flex min-h-screen max-w-6xl flex-col justify-center px-6 pb-16 pt-24">
      <div class="grid items-center gap-12 md:grid-cols-5">
        <div class="md:col-span-3">
          <h1 class="mb-6 font-serif text-4xl font-bold leading-tight text-[var(--ink)] md:text-5xl lg:text-6xl">
            <span class="text-[var(--copper)]">{person.name}</span>
            {tagline && <>{' '}{tagline}</>}
          </h1>
          {heroBio && (
            <p class="mb-10 max-w-2xl text-lg leading-relaxed text-[var(--stone-soft)] md:text-xl">
              {heroBio}
            </p>
          )}
          <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:gap-4">
            {buttonCtas.map((cta, i) =>
              i === 0 ? (
                <a
                  href={cta.href}
                  class="rounded-full bg-[var(--ink)] px-8 py-3.5 text-sm font-medium text-white transition-colors hover:bg-[var(--stone-soft)]"
                >
                  {cta.label}
                </a>
              ) : (
                <a
                  href={cta.href}
                  class="rounded-full border border-[var(--warm-line)] px-8 py-3.5 text-sm font-medium text-[var(--ink)] transition-colors hover:border-[var(--stone-soft)]"
                >
                  {cta.label}
                </a>
              )
            )}
          </div>
          {linkCtas.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-4">
              {linkCtas.map((cta) => (
                <a href={cta.href} class="text-sm font-medium text-[var(--copper)] underline underline-offset-4 transition-colors hover:text-[var(--stone-soft)]">
                  {cta.label}
                </a>
              ))}
            </div>
          )}
        </div>
        {person.photo && (
          <div class="hidden md:col-span-2 md:block">
            <img
              src={resolveAssetUrl(person.photo, base) ?? person.photo}
              alt={person.name}
              class="aspect-[3/4] w-full rounded-3xl object-cover shadow-xl"
            />
          </div>
        )}
      </div>
    </section>

    <!-- Thematic pillars -->
    {pillars.length > 0 && (
      <Reveal
        as="section"
        class="border-t border-[var(--warm-line)] bg-[var(--paper-light)] px-6 py-24"
      >
        <div class="mx-auto max-w-5xl">
          <SectionIntro eyebrow="What I do" heading="Areas of focus" />
          <FeaturePillars pillars={pillars} />
        </div>
      </Reveal>
    )}
  </>
)}

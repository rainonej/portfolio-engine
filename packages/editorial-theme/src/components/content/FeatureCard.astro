---
/**
 * Large highlighted card for featured or pinned items.
 *
 * Renders an optional image, an optional meta line (e.g. date, status),
 * a title, a required description, and a "View →" affordance. Pass
 * `accent` to draw the border in the theme's accent color.
 */
interface Props {
  title: string;
  description: string;
  href: string;
  imageSrc?: string;
  imageAlt?: string;
  meta?: string;
  accent?: boolean;
}

const {
  title,
  description,
  href,
  imageSrc,
  imageAlt,
  meta,
  accent = false,
} = Astro.props;

const borderColorVar = accent
  ? 'var(--color-accent-primary)'
  : 'var(--color-border-default)';
---

<article
  class="group flex h-full flex-col overflow-hidden rounded-2xl border transition-colors hover:border-[var(--color-border-strong)]"
  style={`background-color: var(--color-surface-elevated); border-color: ${borderColorVar};`}
>
  {
    imageSrc && (
      <a href={href} class="block">
        <div class="aspect-[16/9] overflow-hidden bg-[color-mix(in_srgb,var(--color-text-primary)_5%,var(--color-surface-page))]">
          <img
            src={imageSrc}
            alt={imageAlt ?? title}
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
            loading="lazy"
          />
        </div>
      </a>
    )
  }
  <div class="flex flex-1 flex-col p-6">
    {
      meta && (
        <span class="mb-3 text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-accent-primary)]">
          {meta}
        </span>
      )
    }
    <h3
      class="mb-3 font-serif font-bold leading-snug"
      style="font-size: var(--text-subheading);"
    >
      <a
        href={href}
        class="transition-colors hover:text-[var(--color-accent-primary)]"
      >
        {title}
      </a>
    </h3>
    <p class="mb-5 flex-1 text-sm leading-relaxed text-[var(--color-text-muted)]">
      {description}
    </p>
    <a
      href={href}
      class="text-sm font-medium underline underline-offset-4 transition-colors hover:text-[var(--color-accent-primary)]"
    >
      View →
    </a>
  </div>
</article>

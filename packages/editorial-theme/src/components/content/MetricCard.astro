---
/**
 * Single metric or status marker.
 *
 * Renders a large numeric/text value, a short label, and an optional note.
 * Use inside `MetricStrip.astro` or standalone in any screen needing a
 * compact "by the numbers" marker.
 */
interface Props {
  value: string;
  label: string;
  note?: string;
}

const { value, label, note } = Astro.props;
---

<div
  class="rounded-2xl border p-6"
  style="background-color: var(--color-surface-elevated); border-color: var(--color-border-default);"
>
  <p
    class="font-serif font-bold leading-none"
    style="font-size: var(--text-title); color: var(--color-text-primary);"
  >
    {value}
  </p>
  <p class="mt-3 text-xs font-semibold uppercase tracking-[0.14em] text-[var(--color-accent-primary)]">
    {label}
  </p>
  {
    note && (
      <p class="mt-2 text-sm leading-relaxed text-[var(--color-text-muted)]">
        {note}
      </p>
    )
  }
</div>

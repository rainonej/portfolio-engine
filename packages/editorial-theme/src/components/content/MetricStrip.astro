---
/**
 * Row of MetricCard items, wrapping on smaller screens.
 *
 * Pass an array of `{ value, label, note? }` objects and they'll be rendered
 * as a responsive grid (2 → 4 columns). Pass `compact` to shrink padding for
 * dense sidebars.
 */
import MetricCard from './MetricCard.astro';

interface Props {
  metrics: Array<{ value: string; label: string; note?: string }>;
  compact?: boolean;
}

const { metrics, compact = false } = Astro.props;

const gridClass = compact
  ? 'grid grid-cols-2 gap-4 md:grid-cols-4'
  : 'grid grid-cols-1 gap-[var(--space-card-gap)] sm:grid-cols-2 md:grid-cols-4';
---

<div class={gridClass}>
  {metrics.map((metric) => <MetricCard value={metric.value} label={metric.label} note={metric.note} />)}
</div>

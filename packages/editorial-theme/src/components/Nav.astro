---
import type { ResolvedConfig } from '@portfolio-engine/engine-core';
import { config } from '@portfolio-engine:config';
import { getBase } from '../lib/utils';

type NavItem = ResolvedConfig['navigation']['items'][number];

const base = getBase();

function isNavActive(pathname: string, href: string): boolean {
  if (href.startsWith('http://') || href.startsWith('https://')) {
    try {
      const path = new URL(href).pathname;
      return pathname === path || pathname.startsWith(`${path}/`);
    } catch {
      return false;
    }
  }
  return pathname.startsWith(href);
}

function resolveNavHref(href: string): string {
  if (href.startsWith('http://') || href.startsWith('https://') || href.startsWith('//')) {
    return href;
  }
  if (href.startsWith('/')) return `${base}${href}`;
  return `${base}/${href}`;
}

type NavLink = { href: string; label: string };

const links: NavLink[] = config.navigation.items
  .filter((item: NavItem) => item.visible !== false)
  .sort((a: NavItem, b: NavItem) => (a.order ?? 0) - (b.order ?? 0))
  .map(({ href, label }: NavItem) => ({
    href: resolveNavHref(href),
    label,
  }));

const { pathname } = Astro.url;
---

<header
  class="pe-site-header fixed inset-x-0 top-0 z-50 border-b border-[var(--color-border-default)] bg-[var(--color-surface-page)]"
>
  <nav class="pe-site-nav mx-auto flex h-16 max-w-5xl items-center justify-between px-6">
    <a
      href={`${base}/`}
      class="pe-site-brand font-serif text-xl font-bold tracking-tight transition-opacity hover:opacity-60"
    >
      {config.site.title}
    </a>
    <ul class="pe-site-nav-list flex items-center gap-8">
      {
        links.map(({ href, label }: NavLink) => (
          <li class="pe-site-nav-item">
            <a
              href={href}
              class={`pe-site-nav-link text-sm font-medium transition-colors ${
                isNavActive(pathname, href)
                  ? 'text-[var(--color-text-primary)]'
                  : 'text-[var(--color-text-muted)] hover:text-[var(--color-text-primary)]'
              }`}
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

---
export interface Props {
  as?: 'div' | 'section';
  class?: string;
  delay?: number;
}

const { as: tag = 'div', class: className = '', delay = 0 } = Astro.props;
const classList = `reveal ${className}`.trim();
const style = `--reveal-delay:${delay}ms;`;
---

{
  tag === 'section' ? (
    <section class={classList} style={style}>
      <slot />
    </section>
  ) : (
    <div class={classList} style={style}>
      <slot />
    </div>
  )
}

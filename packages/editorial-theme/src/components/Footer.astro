---
import { config } from '@portfolio-engine:config';
import Override from '@portfolio-engine:override/Footer';
import { getBase } from '../lib/utils';

const base = getBase();
const adminOriginEnv =
  import.meta.env.PUBLIC_ADMIN_ORIGIN?.trim().replace(/\/$/, '') ?? '';
const adminOrigin = adminOriginEnv || (base !== '' ? config.site.baseUrl : '');
const adminHref = adminOrigin ? `${adminOrigin}/admin` : `${base}/admin`;

/**
 * Admin link visibility (discoverability only — not authentication):
 * - Always visible in development.
 * - In production: when `PUBLIC_SHOW_ADMIN_LINK=true`, or when `site.json` sets `admin.showPublicLink: true`.
 */
const isDev = import.meta.env.DEV;
const showAdminLinkEnv = import.meta.env.PUBLIC_SHOW_ADMIN_LINK;
const showAdminLinkSite = config.site.admin?.showPublicLink === true;
const showAdminLink = isDev || showAdminLinkEnv === 'true' || showAdminLinkSite;
const adminLinkLabel = (config.site.admin?.publicLinkLabel ?? '').trim() || 'Admin';
---

{
  Override ? (
    <Override adminHref={adminHref} siteTitle={config.site.title} adminLinkLabel={adminLinkLabel} />
  ) : (
    <footer class="mt-24 border-t border-[var(--color-border-default)] px-6 py-10 text-center text-sm text-[var(--color-text-muted)]">
      <p>
        © {new Date().getFullYear()}
        {config.site.title} &middot; Made with{' '}
        <a
          href="https://github.com/rainonej/portfolio-engine"
          class="transition-colors hover:text-[var(--color-text-muted)]"
          target="_blank"
          rel="noopener noreferrer"
        >
          portfolio-engine
        </a>
        {showAdminLink && (
          <>
            {' '}&middot;{' '}
            <a href={adminHref} class="transition-colors hover:text-[var(--color-text-muted)]">
              {adminLinkLabel}
            </a>
          </>
        )}
      </p>
    </footer>
  )
}

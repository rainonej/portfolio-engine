---
import Layout from '../layouts/Layout.astro';
import { config } from '@portfolio-engine:config';
import { loadProfilePerson } from '../lib/load-profile-person';
import SchedulingBlock from '../components/SchedulingBlock.astro';

const person = await loadProfilePerson();

const bookingUrl = config.site.bookingUrl || null;
const { heading: contactHeading, body: contactBody, scheduling } = config.site.contact;

const hasConfiguredScheduling = scheduling?.enabled === true;

const isDev = import.meta.env.DEV;
---

<Layout title={`Contact — ${person.name}`}>
  <section class="mx-auto max-w-5xl px-6 pb-24 pt-40">
    <div class="max-w-xl">
      <p
        class="mb-6 text-xs font-medium uppercase tracking-[0.25em] text-amber-800"
      >
        Get in touch
      </p>
      <h1 class="mb-6 font-serif text-5xl font-bold leading-tight md:text-6xl">
        {contactHeading}
      </h1>
      <p class="mb-14 text-lg leading-relaxed text-stone-500">
        {contactBody}
      </p>

      {hasConfiguredScheduling && <SchedulingBlock {...scheduling} />}

      {
        !hasConfiguredScheduling && bookingUrl && (
          <SchedulingBlock
            enabled={true}
            provider="custom"
            mode="button"
            url={bookingUrl}
            label="Book a conversation"
          />
        )
      }

      {
        person.email && (
          <div class="mt-10">
            <p class="mb-3 text-sm font-medium text-stone-600">Email</p>
            <a
              href={`mailto:${person.email}`}
              class="text-base font-medium text-stone-900 underline underline-offset-4 transition-colors hover:text-amber-800"
            >
              {person.email}
            </a>
          </div>
        )
      }

      {
        !person.email && !hasConfiguredScheduling && !bookingUrl && isDev && (
          <div class="rounded-2xl border border-dashed border-stone-200 bg-stone-50 px-8 py-10 text-center text-stone-400">
            <p class="text-sm">
              [dev] No contact method configured. Add <code class="rounded bg-stone-100 px-1">email</code> to <code class="rounded bg-stone-100 px-1">profile/person.json</code> or configure <code class="rounded bg-stone-100 px-1">bookingUrl</code> in <code class="rounded bg-stone-100 px-1">site.json</code>.
            </p>
          </div>
        )
      }
    </div>
  </section>
</Layout>

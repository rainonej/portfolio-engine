---
import Layout from '../layouts/Layout.astro';
import { config } from '@portfolio-engine:config';
import { loadProfilePerson, resolveProfileEmails } from '../lib/load-profile-person';
import SchedulingBlock from '../components/SchedulingBlock.astro';
import SocialLinks from '../components/SocialLinks.astro';

const person = await loadProfilePerson();
const profileEmails = resolveProfileEmails(person);
const hasSocialLinks = Boolean(person.linkedin || person.github || person.instagram);

const bookingUrl = config.site.bookingUrl || null;
const { heading: contactHeading, body: contactBody, scheduling } = config.site.contact;

const hasConfiguredScheduling = scheduling?.enabled === true;

const isDev = import.meta.env.DEV;
---

<Layout title={`Contact — ${person.name}`}>
  <section class="mx-auto max-w-5xl px-6 pb-24 pt-40">
    <div class="max-w-xl">
      <p
        class="mb-6 text-xs font-medium uppercase tracking-[0.25em] text-[var(--color-accent-primary)]"
      >
        Get in touch
      </p>
      <h1 class="mb-6 font-serif text-5xl font-bold leading-tight md:text-6xl">
        {contactHeading}
      </h1>
      <p class="mb-14 text-lg leading-relaxed text-[var(--color-text-muted)]">
        {contactBody}
      </p>

      {hasConfiguredScheduling && <SchedulingBlock {...scheduling} />}

      {
        !hasConfiguredScheduling && bookingUrl && (
          <SchedulingBlock
            enabled={true}
            provider="custom"
            mode="button"
            url={bookingUrl}
            label="Book a conversation"
          />
        )
      }

      {
        profileEmails.length > 0 && (
          <div class="mt-10">
            <p class="mb-3 text-sm font-medium text-[var(--color-text-muted)]">
              {profileEmails.length === 1 ? 'Email' : 'Email addresses'}
            </p>
            <div class="space-y-3">
              {profileEmails.map((email) => (
                <div>
                  {email.label && (
                    <p class="mb-1 text-xs font-medium uppercase tracking-wider text-[var(--color-accent-primary)]">
                      {email.label}
                    </p>
                  )}
                  <a
                    href={`mailto:${email.address}`}
                    class="text-base font-medium text-[var(--color-text-primary)] underline underline-offset-4 transition-colors hover:text-[var(--color-accent-primary)]"
                  >
                    {email.address}
                  </a>
                </div>
              ))}
            </div>
          </div>
        )
      }

      {hasSocialLinks && <SocialLinks person={person} class="mt-8" />}

      {
        profileEmails.length === 0 && !hasSocialLinks && !hasConfiguredScheduling && !bookingUrl && isDev && (
          <div class="rounded-2xl border border-dashed border-[var(--color-border-default)] bg-[var(--color-surface-wash)] px-8 py-10 text-center text-[var(--color-text-muted)]">
            <p class="text-sm">
              [dev] No contact method configured. Add <code class="rounded bg-[color-mix(in_srgb,var(--color-text-primary)_5%,var(--color-surface-page))] px-1">email</code>, <code class="rounded bg-[color-mix(in_srgb,var(--color-text-primary)_5%,var(--color-surface-page))] px-1">emails</code>, or a social profile to <code class="rounded bg-[color-mix(in_srgb,var(--color-text-primary)_5%,var(--color-surface-page))] px-1">profile/person.json</code>; or configure <code class="rounded bg-[color-mix(in_srgb,var(--color-text-primary)_5%,var(--color-surface-page))] px-1">bookingUrl</code> in <code class="rounded bg-[color-mix(in_srgb,var(--color-text-primary)_5%,var(--color-surface-page))] px-1">site.json</code>.
            </p>
          </div>
        )
      }
    </div>
  </section>
</Layout>

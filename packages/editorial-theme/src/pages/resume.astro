---
import Layout from '../layouts/Layout.astro';
import Reveal from '../components/Reveal.astro';
import SectionIntro from '../components/SectionIntro.astro';
import { getEntry } from 'astro:content';
import { getBase } from '../lib/utils';
import { loadProfilePerson, splitBioParagraphs } from '../lib/load-profile-person';

const base = getBase();
const person = await loadProfilePerson();

const cvEntry = await getEntry('profile', 'cv');
if (!cvEntry) {
  throw new Error('[editorial-theme] Missing content entry profile/cv');
}

type CvExperience = {
  title: string;
  organization: string;
  location?: string;
  startYear?: string | number;
  endYear?: string | number;
  current?: boolean;
  description?: string;
  highlights?: string[];
};

type CvEducation = {
  degree: string;
  institution: string;
  location?: string;
  year?: string | number;
  note?: string;
};

type CvAward = {
  title: string;
  context?: string;
  description?: string;
};

type CvProfileData = {
  experience?: CvExperience[];
  education?: CvEducation[];
  awards?: CvAward[];
};

const cv = cvEntry.data as CvProfileData;

// For the resume summary, prefer longBio or summary over shortBio
const summaryParagraphs: string[] =
  person.longBio && person.longBio.length > 0
    ? person.longBio
    : splitBioParagraphs(person.bio);

const metaDescription =
  person.summary ?? person.shortBio ?? (summaryParagraphs[0] ?? '');
---

<Layout title={`Résumé — ${person.name}`} description={metaDescription}>
  <section class="mx-auto max-w-4xl px-6 pb-24 pt-40">
    <!-- Page header -->
    <div class="mb-16">
      <p class="mb-6 text-xs font-medium uppercase tracking-[0.25em] text-amber-800">
        Résumé
      </p>
      <h1 class="mb-6 font-serif text-5xl font-bold leading-tight md:text-6xl">
        {person.name}
      </h1>
      {summaryParagraphs.length > 0 && (
        <div class="mt-6 max-w-2xl space-y-4 text-lg leading-relaxed text-stone-600">
          {summaryParagraphs.map((para) => (
            <p>{para}</p>
          ))}
        </div>
      )}
      {(person.email || person.linkedin) && (
        <div class="mt-8 flex flex-wrap gap-6">
          {person.email && (
            <a
              href={`mailto:${person.email}`}
              class="flex items-center gap-2 text-sm font-medium text-stone-600 transition-colors hover:text-stone-900"
            >
              <span class="text-amber-700">✉</span>
              {person.email}
            </a>
          )}
          {person.linkedin && (
            <a
              href={person.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 text-sm font-medium text-stone-600 transition-colors hover:text-stone-900"
            >
              <span class="text-amber-700">↗</span>
              LinkedIn
            </a>
          )}
        </div>
      )}
    </div>

    <!-- Credentials / Core Competencies -->
    {
      person.credentials && person.credentials.length > 0 && (
        <div class="mb-16 border-t border-stone-100 pt-10">
          <h2 class="mb-6 font-serif text-2xl font-bold">Core Competencies</h2>
          <ul class="flex flex-wrap gap-3">
            {person.credentials.map((credential) => (
              <li class="rounded-full border border-[var(--warm-line)] bg-[var(--paper-light)] px-4 py-2 text-sm font-medium text-[var(--ink)]">
                {credential}
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <!-- Experience -->
    {
      cv.experience && cv.experience.length > 0 && (
        <div class="mb-16 border-t border-stone-100 pt-10">
          <h2 class="mb-8 font-serif text-2xl font-bold">Experience</h2>
          <div class="space-y-10">
            {cv.experience.map((role: CvExperience) => (
              <div>
                <div class="mb-2 flex flex-wrap items-baseline justify-between gap-2">
                  <h3 class="font-serif text-xl font-bold">{role.title}</h3>
                  <span class="text-sm text-stone-400">
                    {role.startYear}
                    {role.endYear || role.current
                      ? ` – ${role.current ? 'Present' : role.endYear}`
                      : ''}
                  </span>
                </div>
                <p class="mb-3 font-medium text-amber-800">
                  {role.organization}
                  {role.location ? ` · ${role.location}` : ''}
                </p>
                {role.description && (
                  <p class="mb-3 leading-relaxed text-stone-600">{role.description}</p>
                )}
                {role.highlights && role.highlights.length > 0 && (
                  <ul class="space-y-1 pl-4">
                    {role.highlights.map((h: string) => (
                      <li class="relative text-sm leading-relaxed text-stone-600 before:absolute before:-left-4 before:text-amber-700 before:content-['·']">
                        {h}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            ))}
          </div>
        </div>
      )
    }
  </section>

  <!-- Education Section -->
  {
    cv.education && cv.education.length > 0 && (
      <Reveal as="section" class="border-t border-[var(--warm-line)] px-6 py-24">
        <div class="mx-auto max-w-4xl">
          <SectionIntro eyebrow="Education" heading="Academic Background" />
          <div class="grid gap-8 md:grid-cols-2">
            {cv.education.map((entry: CvEducation) => (
              <div class="rounded-2xl border border-stone-100 bg-white p-8">
                <p class="mb-2 text-sm font-medium uppercase tracking-widest text-amber-800">
                  {entry.degree}
                </p>
                <h3 class="mb-3 font-serif text-xl font-bold">{entry.institution}</h3>
                <p class="mb-4 text-stone-500">
                  {entry.location}
                  {entry.location && entry.year ? ' | ' : ''}
                  {entry.year}
                </p>
                {entry.note && (
                  <p class="text-sm leading-relaxed text-stone-600">{entry.note}</p>
                )}
              </div>
            ))}
          </div>
        </div>
      </Reveal>
    )
  }

  <!-- Awards / Recognition -->
  {
    cv.awards && cv.awards.length > 0 && (
      <Reveal
        as="section"
        class="border-t border-[var(--warm-line)] bg-[var(--paper-light)] px-6 py-24"
      >
        <div class="mx-auto max-w-4xl">
          <SectionIntro eyebrow="Recognition" heading="Awards & Honors" />
          <div class="space-y-6">
            {cv.awards.map((award: CvAward) => (
              <div class="flex gap-6">
                <div class="mt-1 h-2 w-2 shrink-0 rounded-full bg-[var(--copper)]" />
                <div>
                  <h3 class="mb-1 font-medium text-[var(--ink)]">{award.title}</h3>
                  {award.context && (
                    <p class="mb-1 text-sm font-medium text-amber-800">{award.context}</p>
                  )}
                  {award.description && (
                    <p class="text-sm leading-relaxed text-stone-600">{award.description}</p>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      </Reveal>
    )
  }
</Layout>

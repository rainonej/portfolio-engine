---
import Layout from '../layouts/Layout.astro';
import Reveal from '../components/Reveal.astro';
import SectionIntro from '../components/SectionIntro.astro';
import { getEntry } from 'astro:content';
import { config } from '@portfolio-engine:config';
import { getBase, resolveAssetUrl } from '../lib/utils';
import { loadProfilePerson, resolveLongBioParagraphs } from '../lib/load-profile-person';

const base = getBase();
const person = await loadProfilePerson();
const resumePdfUrl = resolveAssetUrl(config.site.resumePdfUrl, base);
const resumePdfIsExternal = resumePdfUrl?.startsWith('https://') ?? false;

const cvEntry = await getEntry('profile', 'cv');
if (import.meta.env.DEV && !cvEntry) {
  console.warn(
    '[editorial-theme] Missing content entry profile/cv — résumé sections will be empty until you add it.',
  );
}

type CvExperience = {
  title: string;
  organization: string;
  location?: string;
  startYear?: string | number;
  endYear?: string | number;
  current?: boolean;
  description?: string;
  highlights?: string[];
};

type CvEducation = {
  degree: string;
  institution: string;
  location?: string;
  year?: string | number;
  note?: string;
};

type CvAward = {
  title: string;
  context?: string;
  description?: string;
};

type CvProfileData = {
  experience?: CvExperience[];
  education?: CvEducation[];
  awards?: CvAward[];
};

const cv = (cvEntry?.data ?? {}) as CvProfileData;

/** Prefer longBio paragraphs, then a single summary paragraph. */
const summaryParagraphs: string[] =
  person.longBio && person.longBio.length > 0
    ? person.longBio
    : person.summary?.trim()
      ? [person.summary.trim()]
      : resolveLongBioParagraphs(person);

const metaDescriptionRaw =
  person.summary?.trim() ||
  person.shortBio?.trim() ||
  summaryParagraphs[0]?.trim() ||
  '';
const metaDescription = metaDescriptionRaw ? metaDescriptionRaw : undefined;

function formatExperienceDateRange(role: CvExperience): string | null {
  const startRaw = role.startYear;
  const endRaw = role.endYear;
  const hasStart = startRaw !== undefined && startRaw !== null && String(startRaw).trim() !== '';
  const hasEnd = endRaw !== undefined && endRaw !== null && String(endRaw).trim() !== '';
  const start = hasStart ? String(startRaw) : '';
  if (role.current) {
    return start ? `${start} – Present` : 'Present';
  }
  const end = hasEnd ? String(endRaw) : '';
  if (start && end) return `${start} – ${end}`;
  if (start) return start;
  if (end) return end;
  return null;
}
---

<Layout title={`Résumé — ${person.name}`} description={metaDescription}>
  <section class="mx-auto max-w-4xl px-6 pb-24 pt-40">
    <!-- Page header -->
    <div class="mb-16">
      <p class="mb-6 text-xs font-medium uppercase tracking-[0.25em] text-[var(--color-accent-primary)]">
        Résumé
      </p>
      <h1 class="mb-6 font-serif text-5xl font-bold leading-tight md:text-6xl">
        {person.name}
      </h1>
      {
        resumePdfUrl && (
          <a
            href={resumePdfUrl}
            download={resumePdfIsExternal ? undefined : true}
            target={resumePdfIsExternal ? '_blank' : undefined}
            rel={resumePdfIsExternal ? 'noopener noreferrer' : undefined}
            class="mb-8 inline-flex min-h-11 items-center justify-center gap-2 rounded-full border border-[var(--color-accent-primary)] bg-[var(--color-accent-primary)] px-5 py-2.5 text-sm font-semibold text-[var(--color-surface-page)] transition-colors hover:bg-transparent hover:text-[var(--color-accent-primary)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-accent-primary)]"
          >
            <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 3v12m0 0 4-4m-4 4-4-4M5 21h14" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            Download résumé PDF
          </a>
        )
      }
      {summaryParagraphs.length > 0 && (
        <div class="mt-6 max-w-2xl space-y-4 text-lg leading-relaxed text-[var(--color-text-muted)]">
          {summaryParagraphs.map((para) => (
            <p>{para}</p>
          ))}
        </div>
      )}
      {(person.email || person.linkedin) && (
        <div class="mt-8 flex flex-wrap gap-6">
          {person.email && (
            <a
              href={`mailto:${person.email}`}
              class="flex items-center gap-2 text-sm font-medium text-[var(--color-text-muted)] transition-colors hover:text-[var(--color-text-primary)]"
            >
              <span class="text-[var(--color-accent-primary)]">✉</span>
              {person.email}
            </a>
          )}
          {person.linkedin && (
            <a
              href={person.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 text-sm font-medium text-[var(--color-text-muted)] transition-colors hover:text-[var(--color-text-primary)]"
            >
              <span class="text-[var(--color-accent-primary)]">↗</span>
              LinkedIn
            </a>
          )}
        </div>
      )}
    </div>

    {
      !cvEntry && (
        <div class="mb-16 rounded-xl border border-[var(--color-border-default)] bg-[var(--color-surface-elevated)] px-6 py-5 text-sm leading-relaxed text-[var(--color-text-muted)]">
          <p class="font-medium text-[var(--color-text-primary)]">Résumé details not configured</p>
          <p class="mt-2">
            Add a <code class="rounded bg-[var(--color-surface-page)] px-1.5 py-0.5 text-[var(--color-text-primary)]">profile/cv</code>{' '}
            content entry to show experience, education, and awards.
          </p>
        </div>
      )
    }

    <!-- Credentials / Core Competencies -->
    {
      person.credentials && person.credentials.length > 0 && (
        <div class="mb-16 border-t border-[var(--color-border-default)] pt-10">
          <h2 class="mb-6 font-serif text-2xl font-bold">Core Competencies</h2>
          <ul class="flex flex-wrap gap-3">
            {person.credentials.map((credential) => (
              <li class="rounded-full border border-[var(--color-border-default)] bg-[var(--color-surface-elevated)] px-4 py-2 text-sm font-medium text-[var(--color-text-primary)]">
                {credential}
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <!-- Experience -->
    {
      cv.experience && cv.experience.length > 0 && (
        <div class="mb-16 border-t border-[var(--color-border-default)] pt-10">
          <h2 class="mb-8 font-serif text-2xl font-bold">Experience</h2>
          <div class="space-y-10">
            {cv.experience.map((role: CvExperience) => {
              const dateRange = formatExperienceDateRange(role);
              return (
              <div>
                <div class="mb-2 flex flex-wrap items-baseline justify-between gap-2">
                  <h3 class="font-serif text-xl font-bold">{role.title}</h3>
                  {dateRange && (
                    <span class="text-sm text-[var(--color-text-muted)]">{dateRange}</span>
                  )}
                </div>
                <p class="mb-3 font-medium text-[var(--color-accent-primary)]">
                  {role.organization}
                  {role.location ? ` · ${role.location}` : ''}
                </p>
                {role.description && (
                  <p class="mb-3 leading-relaxed text-[var(--color-text-muted)]">{role.description}</p>
                )}
                {role.highlights && role.highlights.length > 0 && (
                  <ul class="space-y-1 pl-4">
                    {role.highlights.map((h: string) => (
                      <li class="relative text-sm leading-relaxed text-[var(--color-text-muted)] before:absolute before:-left-4 before:text-[var(--color-accent-primary)] before:content-['·']">
                        {h}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
              );
            })}
          </div>
        </div>
      )
    }
  </section>

  <!-- Education Section -->
  {
    cv.education && cv.education.length > 0 && (
      <Reveal as="section" class="border-t border-[var(--color-border-default)] px-6 py-24">
        <div class="mx-auto max-w-4xl">
          <SectionIntro eyebrow="Education" heading="Academic Background" />
          <div class="grid gap-8 md:grid-cols-2">
            {cv.education.map((entry: CvEducation) => (
              <div class="rounded-2xl border border-[var(--color-border-default)] bg-[var(--color-surface-elevated)] p-8">
                <p class="mb-2 text-sm font-medium uppercase tracking-widest text-[var(--color-accent-primary)]">
                  {entry.degree}
                </p>
                <h3 class="mb-3 font-serif text-xl font-bold">{entry.institution}</h3>
                <p class="mb-4 text-[var(--color-text-muted)]">
                  {entry.location}
                  {entry.location && entry.year ? ' | ' : ''}
                  {entry.year}
                </p>
                {entry.note && (
                  <p class="text-sm leading-relaxed text-[var(--color-text-muted)]">{entry.note}</p>
                )}
              </div>
            ))}
          </div>
        </div>
      </Reveal>
    )
  }

  <!-- Awards / Recognition -->
  {
    cv.awards && cv.awards.length > 0 && (
      <Reveal
        as="section"
        class="border-t border-[var(--color-border-default)] bg-[var(--color-surface-elevated)] px-6 py-24"
      >
        <div class="mx-auto max-w-4xl">
          <SectionIntro eyebrow="Recognition" heading="Awards & Honors" />
          <div class="space-y-6">
            {cv.awards.map((award: CvAward) => (
              <div class="flex gap-6">
                <div class="mt-1 h-2 w-2 shrink-0 rounded-full bg-[var(--color-accent-primary)]" />
                <div>
                  <h3 class="mb-1 font-medium text-[var(--color-text-primary)]">{award.title}</h3>
                  {award.context && (
                    <p class="mb-1 text-sm font-medium text-[var(--color-accent-primary)]">{award.context}</p>
                  )}
                  {award.description && (
                    <p class="text-sm leading-relaxed text-[var(--color-text-muted)]">{award.description}</p>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      </Reveal>
    )
  }
</Layout>

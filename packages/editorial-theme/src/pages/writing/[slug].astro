---
import Layout from '../../layouts/Layout.astro';
import { render } from 'astro:content';
import ImageOrFallback from '../../components/ImageOrFallback.astro';
import { getBase, formatDate, resolveAssetUrl } from '../../lib/utils';
import { loadProfilePerson } from '../../lib/load-profile-person';
import { getWritingPosts, type WritingEntry } from '../../lib/collections';

type Props = {
  entry: WritingEntry;
};

export async function getStaticPaths() {
  const posts = await getWritingPosts();
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const person = await loadProfilePerson();

const { entry }: Props = Astro.props;
const { Content } = await render(entry);
const p = entry.data;
const base = getBase();
---

<Layout title={`${p.title} — ${person.name}`} description={p.description}>
  <article class="mx-auto max-w-3xl px-6 pb-24 pt-40">
    <a
      href={`${base}/writing`}
      class="mb-8 inline-block text-sm text-[var(--color-text-muted)] transition-colors hover:text-[var(--color-text-primary)]"
    >
      ← Back to Writing
    </a>

    <div class="mb-10 aspect-[21/9] overflow-hidden rounded-2xl bg-[color-mix(in_srgb,var(--color-text-primary)_5%,var(--color-surface-page))]">
      <ImageOrFallback
        src={p.image ? resolveAssetUrl(p.image, base) : null}
        alt={p.title}
        fallbackChar={p.title[0]}
        class="h-full w-full object-cover"
        loading="lazy"
      />
    </div>

    <div class="mb-4 flex flex-wrap items-center gap-3">
      <time class="text-xs text-[var(--color-text-muted)]" datetime={p.date.toISOString()}>
        {formatDate(p.date)}
      </time>
      {
        p.tags?.map((tag: string) => (
          <span class="text-xs font-medium uppercase tracking-widest text-[var(--color-accent-primary)]">
            {tag}
          </span>
        ))
      }
    </div>

    <h1 class="mb-4 font-serif text-4xl font-bold leading-tight md:text-5xl">
      {p.title}
    </h1>

    {
      p.description && (
        <p class="mb-10 text-xl leading-relaxed text-[var(--color-text-muted)]">
          {p.description}
        </p>
      )
    }

    <div
      class="prose prose-stone prose-headings:font-serif prose-a:text-[var(--color-accent-primary)] prose-a:underline-offset-4 max-w-none"
    >
      <Content />
    </div>
  </article>
</Layout>

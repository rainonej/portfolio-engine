---
/**
 * This file controls the default individual work item screen.
 *
 * It creates one visitor-facing screen for each item in the work content folder.
 * It decides where the title, image, tags, description, and body text appear.
 */
import Layout from '../../layouts/Layout.astro';
import { render } from 'astro:content';
import ImageOrFallback from '../../components/ImageOrFallback.astro';
import { getBase, resolveAssetUrl } from '../../lib/utils';
import { loadProfilePerson } from '../../lib/load-profile-person';
import { getProjects, type ProjectEntry } from '../../lib/collections';

type Props = {
  entry: ProjectEntry;
};

export async function getStaticPaths() {
  const projects = await getProjects({ visibility: 'buildable' });
  return projects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const person = await loadProfilePerson();

const { entry }: Props = Astro.props;
const { Content } = await render(entry);
const p = entry.data;
const base = getBase();
---

<Layout title={`${p.title} — ${person.name}`} description={p.description}>
  <article class="mx-auto max-w-3xl px-6 pb-24 pt-40">
    <a
      href={`${base}/work`}
      class="mb-8 inline-block text-sm text-[var(--color-text-muted)] transition-colors hover:text-[var(--color-text-primary)]"
    >
      ← Back to Work
    </a>
    <div class="mb-10 aspect-[16/9] overflow-hidden rounded-2xl bg-[color-mix(in_srgb,var(--color-text-primary)_5%,var(--color-surface-page))]">
      <ImageOrFallback
        src={p.image ? resolveAssetUrl(p.image, base) : null}
        alt={p.title}
        fallbackChar={p.title[0]}
        class="h-full w-full object-cover"
        loading="lazy"
      />
    </div>
    <div class="mb-4 flex flex-wrap gap-3">
      {
        p.tags?.map((tag: string) => (
          <span class="text-xs font-medium uppercase tracking-widest text-[var(--color-accent-primary)]">
            {tag}
          </span>
        ))
      }
    </div>
    <h1 class="mb-4 font-serif text-4xl font-bold md:text-5xl">{p.title}</h1>
    {
      p.description && (
        <p class="mb-10 text-lg leading-relaxed text-[var(--color-text-muted)]">
          {p.description}
        </p>
      )
    }
    <div class="prose prose-stone max-w-none">
      <Content />
    </div>
    {
      p.link && (
        <p class="mt-10">
          <a
            href={p.link}
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-medium text-[var(--color-accent-primary)] underline underline-offset-4"
          >
            View project →
          </a>
        </p>
      )
    }
  </article>
</Layout>

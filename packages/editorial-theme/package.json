{
  "name": "@portfolio-engine/editorial-theme",
  "version": "0.7.1",
  "description": "The first-party Astro theme built on @portfolio-engine/engine-core",
  "type": "module",
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./integration": {
      "types": "./dist/integration-public.d.ts",
      "import": "./dist/integration-public.js"
    },
    "./layouts/Layout.astro": "./dist/layouts/Layout.astro",
    "./styles/global.css": "./dist/styles/global.css",
    "./styles/design-tokens.css": "./dist/styles/design-tokens.css",
    "./components/ThemeTypographyOverrides.astro": "./dist/components/ThemeTypographyOverrides.astro",
    "./components/ThemeTokenOverrides.astro": "./dist/components/ThemeTokenOverrides.astro",
    "./components/SchedulingBlock.astro": "./dist/components/SchedulingBlock.astro",
    "./components/IframeEmbed.astro": "./dist/components/IframeEmbed.astro",
    "./components/content/ContentSectionHeader.astro": "./dist/components/content/ContentSectionHeader.astro",
    "./components/content/LinkCard.astro": "./dist/components/content/LinkCard.astro",
    "./components/content/FeatureCard.astro": "./dist/components/content/FeatureCard.astro",
    "./components/content/EvidenceCard.astro": "./dist/components/content/EvidenceCard.astro",
    "./components/content/MetricCard.astro": "./dist/components/content/MetricCard.astro",
    "./components/content/MetricStrip.astro": "./dist/components/content/MetricStrip.astro",
    "./components/content/QuoteCard.astro": "./dist/components/content/QuoteCard.astro",
    "./components/content/CardGrid.astro": "./dist/components/content/CardGrid.astro",
    "./components/content/ArticlePreviewCard.astro": "./dist/components/content/ArticlePreviewCard.astro",
    "./components/content/RelatedLinkCard.astro": "./dist/components/content/RelatedLinkCard.astro",
    "./components/content/TagList.astro": "./dist/components/content/TagList.astro"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "check": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "astro": "^6.0.0"
  },
  "dependencies": {
    "@portfolio-engine/engine-core": "workspace:*",
    "@portfolio-engine/schema": "workspace:*",
    "@tailwindcss/postcss": "^4.2.4",
    "tailwindcss": "^4.2.4"
  },
  "devDependencies": {
    "astro": "^6.2.2",
    "typescript": "^6.0.0"
  }
}

---
import type { ProfilePerson } from '@portfolio-engine/editorial-theme';
import { resolveHeroBio } from '@portfolio-engine/editorial-theme';

/**
 * Demo override for the Hero surface.
 *
 * This file exists to prove the override bridge works end-to-end.
 * Replace or remove it in a real consumer site.
 */
interface Pillar {
  heading: string;
  body: string;
  image?: string;
}

type Person = Pick<ProfilePerson, 'name' | 'shortBio' | 'summary' | 'longBio' | 'photo'>;

interface Props {
  person: Person;
  bookingUrl: string | null;
  pillars: Pillar[];
  base: string;
  tagline?: string;
}

const { person, tagline } = Astro.props;
const heroLine = resolveHeroBio(person);
---

<section
  class="mx-auto flex min-h-screen max-w-6xl flex-col justify-center px-6 pb-16 pt-24"
  data-override="Hero"
>
  <div class="max-w-2xl">
    <p class="mb-3 font-mono text-xs uppercase tracking-widest text-[var(--color-accent-primary)]">
      override active
    </p>
    <h1 class="mb-6 font-serif text-5xl font-bold leading-tight text-[var(--color-text-primary)]">
      {person.name}
      {tagline && (
        <span class="block text-3xl font-normal text-[var(--color-text-muted)]">{tagline}</span>
      )}
    </h1>
    <p class="text-lg leading-relaxed text-[var(--color-text-muted)]">{heroLine}</p>
  </div>
</section>

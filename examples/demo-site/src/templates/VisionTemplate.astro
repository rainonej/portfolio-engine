---
import Layout from '@portfolio-engine/editorial-theme/layouts/Layout.astro';
import type { ValueCard, WorkingPrinciple } from '@portfolio-engine/schema';

interface PageData {
  meta: { title: string; description: string };
  intro?: { paragraphs?: string[] };
  sections?: { eyebrow?: string; heading: string }[];
  demoNote?: string;
}

interface Props {
  page: PageData;
  values: ValueCard[];
  principles: WorkingPrinciple[];
}

const { page, values, principles } = Astro.props;
const [valuesSection, principlesSection] = page.sections ?? [];
---

<Layout title={page.meta.title} description={page.meta.description}>
  <main class="mx-auto max-w-3xl px-6 pb-24 pt-40">
    <p
      class="mb-3 font-mono text-[11px] uppercase tracking-[0.2em] text-[var(--color-accent-primary)]"
    >
      Consumer-local route · src/pages-local/vision.astro
    </p>
    <h1 class="mb-6 font-serif text-5xl font-bold leading-tight">Vision</h1>

    {
      page.intro?.paragraphs && (
        <section class="mb-16 space-y-5 text-lg leading-relaxed text-[var(--color-text-muted)]">
          {page.intro.paragraphs.map((p) => (
            <p set:html={p} />
          ))}
        </section>
      )
    }

    {
      values.length > 0 && valuesSection && (
        <section class="mb-16">
          <h2 class="mb-2 font-mono text-[11px] uppercase tracking-[0.2em] text-[var(--color-accent-primary)]">
            {valuesSection.eyebrow}
          </h2>
          <h3 class="mb-8 font-serif text-3xl font-bold">{valuesSection.heading}</h3>
          <ol class="space-y-8">
            {values.map((value, index) => (
              <li class="flex gap-6">
                <span class="mt-1 inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-[var(--color-border-default)] bg-[var(--color-surface-wash)] font-mono text-xs font-bold text-[var(--color-accent-primary)]">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <div>
                  <h4 class="mb-2 font-serif text-2xl font-semibold leading-tight">
                    {value.title}
                  </h4>
                  <p class="text-base leading-relaxed text-[var(--color-text-muted)]">
                    {value.body}
                  </p>
                </div>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      principles.length > 0 && principlesSection && (
        <section class="mb-12">
          <h2 class="mb-2 font-mono text-[11px] uppercase tracking-[0.2em] text-[var(--color-accent-primary)]">
            {principlesSection.eyebrow}
          </h2>
          <h3 class="mb-8 font-serif text-3xl font-bold">{principlesSection.heading}</h3>
          <ul class="grid gap-6 sm:grid-cols-2">
            {principles.map((principle) => (
              <li class="rounded-2xl border border-[var(--color-border-default)] bg-[var(--color-surface-wash)] p-5">
                <h4 class="mb-2 font-serif text-lg font-semibold">{principle.title}</h4>
                <p class="text-sm leading-relaxed text-[var(--color-text-muted)]">{principle.body}</p>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      page.demoNote && (
        <aside data-pe-feature-callout>
          <strong>Demo note</strong>
          {page.demoNote}
        </aside>
      )
    }
  </main>
</Layout>

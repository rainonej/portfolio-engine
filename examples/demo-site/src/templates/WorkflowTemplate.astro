---
import Layout from '@portfolio-engine/editorial-theme/layouts/Layout.astro';

interface Lane {
  eyebrow?: string;
  heading: string;
  body: string;
  examples?: string[];
}

interface Guardrail {
  title: string;
  body: string;
}

interface PageSection {
  eyebrow?: string;
  heading: string;
}

interface PageData {
  meta: { title: string; description: string };
  intro?: { dek?: string };
  sections?: PageSection[];
  lanes?: Lane[];
  guardrails?: Guardrail[];
  demoNote?: string;
}

interface Props {
  page: PageData;
  repoUrl: string;
  issuesUrl: string;
}

const { page, repoUrl, issuesUrl } = Astro.props;
const goodFirstIssuesUrl = `${repoUrl}/issues?q=is%3Aissue+is%3Aopen+label%3A%22good+first+issue%22`;

const [lanesSection, guardrailsSection, ctaSection] = page.sections ?? [];
---

<Layout title={page.meta.title} description={page.meta.description}>
  <main class="mx-auto max-w-4xl px-6 pb-24 pt-40">
    <p
      class="mb-3 font-mono text-[11px] uppercase tracking-[0.2em] text-[var(--color-accent-primary)]"
    >
      Consumer-local route · src/pages-local/workflow.astro
    </p>
    <h1 class="mb-6 font-serif text-5xl font-bold leading-tight">Workflow</h1>

    {
      page.intro?.dek && (
        <p class="mb-12 max-w-3xl text-xl leading-relaxed text-[var(--color-text-muted)]">
          {page.intro.dek}
        </p>
      )
    }

    {
      page.lanes && page.lanes.length > 0 && lanesSection && (
        <section class="mb-16">
          {lanesSection.eyebrow && (
            <h2 class="mb-2 font-mono text-[11px] uppercase tracking-[0.2em] text-[var(--color-accent-primary)]">
              {lanesSection.eyebrow}
            </h2>
          )}
          <h3 class="mb-8 font-serif text-3xl font-bold">{lanesSection.heading}</h3>
          <ol class="space-y-8">
            {page.lanes.map((lane) => (
              <li class="rounded-2xl border border-[var(--color-border-default)] bg-[var(--color-surface-wash)] p-6">
                {lane.eyebrow && (
                  <p class="mb-2 font-mono text-[11px] uppercase tracking-[0.2em] text-[var(--color-accent-primary)]">
                    {lane.eyebrow}
                  </p>
                )}
                <h4 class="mb-3 font-serif text-2xl font-semibold leading-tight">{lane.heading}</h4>
                <p class="mb-4 text-base leading-relaxed text-[var(--color-text-muted)]">
                  {lane.body}
                </p>
                {lane.examples && (
                  <ul class="grid gap-1 text-sm text-[var(--color-text-muted)] sm:grid-cols-2">
                    {lane.examples.map((example) => (
                      <li class="flex gap-2 before:content-['—'] before:text-[var(--color-accent-primary)]">
                        <span>{example}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      page.guardrails && page.guardrails.length > 0 && guardrailsSection && (
        <section class="mb-16">
          {guardrailsSection.eyebrow && (
            <h2 class="mb-2 font-mono text-[11px] uppercase tracking-[0.2em] text-[var(--color-accent-primary)]">
              {guardrailsSection.eyebrow}
            </h2>
          )}
          <h3 class="mb-8 font-serif text-3xl font-bold">{guardrailsSection.heading}</h3>
          <dl class="space-y-6">
            {page.guardrails.map((g) => (
              <div>
                <dt class="mb-1 font-serif text-xl font-semibold">{g.title}</dt>
                <dd class="text-base leading-relaxed text-[var(--color-text-muted)]">{g.body}</dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }

    {
      ctaSection && (
        <section>
          {ctaSection.eyebrow && (
            <h2 class="mb-2 font-mono text-[11px] uppercase tracking-[0.2em] text-[var(--color-accent-primary)]">
              {ctaSection.eyebrow}
            </h2>
          )}
          <h3 class="mb-8 font-serif text-3xl font-bold">{ctaSection.heading}</h3>
          <div class="flex flex-col gap-3 sm:flex-row sm:gap-4">
            <a
              href={issuesUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-full bg-[var(--color-text-primary)] px-6 py-3 text-sm font-medium text-[var(--color-text-inverse)] transition-colors hover:bg-[var(--color-text-muted)]"
            >
              Open an issue <span aria-hidden="true">↗</span>
            </a>
            <a
              href={goodFirstIssuesUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-full border border-[var(--color-border-default)] px-6 py-3 text-sm font-medium text-[var(--color-text-primary)] transition-colors hover:border-[var(--color-text-muted)]"
            >
              Browse good first issues <span aria-hidden="true">↗</span>
            </a>
          </div>
        </section>
      )
    }

    {
      page.demoNote && (
        <aside data-pe-feature-callout class="mt-12">
          <strong>Demo note</strong>
          {page.demoNote}
        </aside>
      )
    }
  </main>
</Layout>

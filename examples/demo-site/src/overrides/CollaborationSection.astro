---
/**
 * Demo override for the `CollaborationSection` surface.
 *
 * Declared props: `base`, `ctaBody`. The default surface renders a generic
 * "let's collaborate" CTA. For the showcase, this override pivots to a
 * "contribute to Portfolio Engine" CTA pointing at the GitHub repository
 * and the issue tracker. No booking funnel — the demo-site exists to onboard
 * open-source contributors, not to sell a private walkthrough.
 *
 * See: docs/downstream/consumption.md
 */
interface Props {
  base: string;
  ctaBody?: string;
}

const { base, ctaBody } = Astro.props;
const repoUrl = 'https://github.com/rainonej/portfolio-engine';
const issuesUrl = `${repoUrl}/issues`;
---

<section
  class="border-t border-[var(--color-border-default)] bg-[var(--color-surface-elevated,var(--color-surface-wash))] px-6 py-28"
  data-override="CollaborationSection"
>
  <div class="mx-auto max-w-3xl text-center">
    <p class="mb-4 font-mono text-[10px] uppercase tracking-[0.2em] text-[var(--color-accent-primary)]">
      demo: CollaborationSection override
    </p>
    <h2 class="mb-5 font-serif text-4xl font-bold md:text-5xl">
      Contribute to Portfolio Engine
    </h2>
    {ctaBody && (
      <p class="mx-auto mb-10 max-w-xl text-lg leading-relaxed text-[var(--color-text-muted)]">
        {ctaBody}
      </p>
    )}
    <div class="flex flex-col items-center justify-center gap-4 sm:flex-row sm:gap-5">
      <a
        href={issuesUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full bg-[var(--color-text-primary)] px-8 py-3.5 text-sm font-medium text-[var(--color-text-inverse)] transition-colors hover:bg-[var(--color-text-muted)]"
      >
        Open an issue
        <span aria-hidden="true">↗</span>
      </a>
      <a
        href={repoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full border border-[var(--color-border-default)] px-8 py-3.5 text-sm font-medium text-[var(--color-text-primary)] transition-colors hover:border-[var(--color-text-muted)]"
      >
        Inspect the code
        <span aria-hidden="true">↗</span>
      </a>
    </div>
    <p class="mt-10 text-sm text-[var(--color-text-muted)]">
      Or read the <a href={`${base}/contribute`} class="underline underline-offset-4 transition-colors hover:text-[var(--color-text-primary)]">contributor guide</a> to see where Astro developers, designers, accessibility reviewers, AI-coding-agent users, and site owners can plug in.
    </p>
  </div>
</section>

---
/**
 * Demo override for the `Hero` surface.
 *
 * Declared in `packages/editorial-theme/src/registry.ts`. The demo-site is
 * the showcase for the *project*, not a generated personal portfolio, so
 * the hero CTAs route visitors to the open-source positioning content
 * (`/vision`, `/workflow`) and to the GitHub repository instead of to a
 * booking widget.
 *
 * See: docs/downstream/consumption.md
 */
import { resolveAssetUrl, resolveHeroBio } from '@portfolio-engine/editorial-theme';

interface Pillar {
  heading: string;
  body: string;
  image?: string;
}

interface HeroCta {
  label: string;
  href: string;
  variant?: 'primary' | 'secondary' | 'link';
  priority?: number;
}

interface Person {
  name: string;
  shortBio?: string;
  summary?: string;
  longBio?: string[];
  photo?: string;
  roleLine?: string;
}

interface Props {
  person: Person;
  bookingUrl: string | null;
  pillars: Pillar[];
  base: string;
  tagline?: string;
  ctas?: HeroCta[];
}

const { person, pillars, base, tagline } = Astro.props;
const heroLine = resolveHeroBio(person);
const photoSrc = person.photo
  ? (resolveAssetUrl(person.photo, base) ?? person.photo)
  : null;

// Demo-site hero CTAs route to the project's positioning pages and the
// GitHub repo. Booking / scheduling links are intentionally absent — the
// site is a contributor-onboarding showcase, not a service funnel. The
// `bookingUrl` and `ctas` props from the theme are ignored on purpose so
// the demo's hero stays predictable for AI agents reading the docs.
const REPO_URL = 'https://github.com/rainonej/portfolio-engine';
const ISSUES_URL = `${REPO_URL}/issues`;

const demoCtas: HeroCta[] = [
  { label: 'Read the vision', href: `${base}/vision`, variant: 'primary', priority: 1 },
  { label: 'See the workflow', href: `${base}/workflow`, variant: 'secondary', priority: 2 },
  { label: 'Inspect the code', href: REPO_URL, variant: 'link', priority: 3 },
  { label: 'Open an issue', href: ISSUES_URL, variant: 'link', priority: 4 },
];

// Sanitize every href to one of two safe shapes before it reaches
// `<a href>`:
//   1. Same-origin absolute paths starting with a single `/`.
//   2. Fully-qualified https:// URLs.
// Mirrors the validation rules in the theme's IframeEmbed component so
// the override and the embed treat unsafe href values the same way.
//
// Explicitly rejected:
//   - javascript:, data:, mailto:, http:, and any other non-https scheme
//   - protocol-relative URLs (`//host/…`) — they start with `/` but
//     navigate cross-origin
//   - backslashes in same-origin paths (WHATWG URL parsers normalize `\`
//     to `/` and can redirect the link cross-origin)
//   - control characters (U+0000–U+001F, U+007F) that some parsers strip
//     and others don't, which is a divergence attackers can exploit

// eslint-disable-next-line no-control-regex
const CTA_CONTROL_CHAR_RE = /[\u0000-\u001F\u007F]/;

function isSafeCtaHref(href: string): boolean {
  if (typeof href !== 'string' || href.length === 0) return false;
  if (CTA_CONTROL_CHAR_RE.test(href)) return false;
  if (href.startsWith('/')) {
    if (href.startsWith('//')) return false;
    if (href.includes('\\')) return false;
    return true;
  }
  try {
    const u = new URL(href);
    return u.protocol === 'https:';
  } catch {
    return false;
  }
}

const sanitizedCtas: HeroCta[] = demoCtas.filter((cta) => isSafeCtaHref(cta.href));

const buttonCtas = sanitizedCtas.filter((c) => c.variant !== 'link').slice(0, 2);
const linkCtas = [
  ...sanitizedCtas.filter((c) => c.variant !== 'link').slice(2),
  ...sanitizedCtas.filter((c) => c.variant === 'link'),
];
---

<section
  class="pe-demo-hero relative mx-auto max-w-6xl px-6 pb-16 pt-28 md:pt-32"
  data-override="Hero"
>
  <div
    class="absolute right-6 top-24 hidden rounded-full border border-[var(--color-border-default)] bg-[var(--color-surface-wash)] px-3 py-1 font-mono text-[10px] uppercase tracking-[0.18em] text-[var(--color-accent-primary)] md:inline-block"
    role="note"
    aria-label="This Hero is rendered by a consumer-supplied override"
  >
    demo: Hero override active
  </div>

  <div class="grid items-center gap-12 md:grid-cols-5">
    <div class="md:col-span-3">
      {person.roleLine && (
        <p class="mb-4 font-mono text-xs uppercase tracking-[0.18em] text-[var(--color-accent-primary)]">
          {person.roleLine}
        </p>
      )}
      <h1 class="mb-6 font-serif text-5xl font-bold leading-[1.05] text-[var(--color-text-primary)] md:text-6xl lg:text-7xl">
        {person.name}
        {tagline && (
          <span class="mt-2 block font-serif text-2xl font-normal italic text-[var(--color-text-muted)] md:text-3xl">
            {tagline}
          </span>
        )}
      </h1>
      {heroLine && (
        <p class="mb-8 max-w-2xl text-lg leading-relaxed text-[var(--color-text-muted)] md:text-xl">
          {heroLine}
        </p>
      )}

      <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:gap-4">
        {buttonCtas.map((cta, index) => {
          const tier = cta.variant ?? (index === 0 ? 'primary' : 'secondary');
          const isPrimary = tier === 'primary';
          const isExternal = cta.href.startsWith('https://');
          return (
            <a
              href={cta.href}
              target={isExternal ? '_blank' : undefined}
              rel={isExternal ? 'noopener noreferrer' : undefined}
              class={
                isPrimary
                  ? 'rounded-full bg-[var(--color-text-primary)] px-8 py-3.5 text-sm font-medium text-[var(--color-text-inverse)] transition-colors hover:bg-[var(--color-text-muted)]'
                  : 'rounded-full border border-[var(--color-border-default)] px-8 py-3.5 text-sm font-medium text-[var(--color-text-primary)] transition-colors hover:border-[var(--color-text-muted)]'
              }
            >
              {cta.label}
            </a>
          );
        })}
      </div>

      {linkCtas.length > 0 && (
        <div class="mt-5 flex flex-wrap gap-5">
          {linkCtas.map((cta) => {
            const isExternal = cta.href.startsWith('https://');
            return (
              <a
                href={cta.href}
                target={isExternal ? '_blank' : undefined}
                rel={isExternal ? 'noopener noreferrer' : undefined}
                class="text-sm font-medium text-[var(--color-accent-primary)] underline underline-offset-4 transition-colors hover:text-[var(--color-text-muted)]"
              >
                {cta.label} →
              </a>
            );
          })}
        </div>
      )}
    </div>

    {photoSrc && (
      <div class="hidden md:col-span-2 md:block">
        <div class="aspect-[3/4] w-full overflow-hidden rounded-3xl border border-[var(--color-border-default)] bg-[var(--color-surface-wash)] shadow-xl">
          <img
            src={photoSrc}
            alt={`${person.name} mark`}
            class="h-full w-full object-contain p-8"
          />
        </div>
      </div>
    )}
  </div>

  {pillars.length > 0 && (
    <div class="mt-20 grid gap-8 border-t border-[var(--color-border-default)] pt-12 md:grid-cols-3">
      {pillars.map((pillar) => (
        <div class="pe-demo-pillar">
          <p class="mb-2 font-mono text-[10px] uppercase tracking-[0.2em] text-[var(--color-accent-primary)]">
            @portfolio-engine
          </p>
          <h3 class="mb-3 font-serif text-2xl font-semibold text-[var(--color-text-primary)]">
            {pillar.heading}
          </h3>
          <p class="text-sm leading-relaxed text-[var(--color-text-muted)]">
            {pillar.body}
          </p>
        </div>
      ))}
    </div>
  )}
</section>

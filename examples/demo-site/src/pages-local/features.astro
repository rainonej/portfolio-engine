---
// Consumer-local route — declared in src/registry/portfolio-engine.registry.json.
// Thin host: loads feature matrix from content/pages/features.yaml and passes
// live registry data from the theme. All rendering is in FeaturesTemplate.
import { getEntry } from 'astro:content';
import {
  DEFAULT_OVERRIDE_SURFACES,
  DEFAULT_ROUTE_REGISTRY,
} from '@portfolio-engine/editorial-theme';
import FeaturesTemplate from '../templates/FeaturesTemplate.astro';

const pageEntry = await getEntry('pages', 'features');
if (!pageEntry) throw new Error('features.astro: pages/features.yaml is required.');
---

<FeaturesTemplate
  page={pageEntry.data}
  routeRegistry={DEFAULT_ROUTE_REGISTRY}
  overrideSurfaces={DEFAULT_OVERRIDE_SURFACES}
/>

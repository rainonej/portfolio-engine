---
/**
 * Consumer-local route — declared in src/registry/portfolio-engine.registry.json.
 *
 * Demonstrates: a consumer-local page reading the theme's published
 * registry constants (DEFAULT_ROUTE_REGISTRY, DEFAULT_OVERRIDE_SURFACES)
 * directly from @portfolio-engine/editorial-theme. The registry contract
 * is legible from the consumer, not a black box hidden in the integration.
 */
import Layout from '@portfolio-engine/editorial-theme/layouts/Layout.astro';
import {
  DEFAULT_OVERRIDE_SURFACES,
  DEFAULT_ROUTE_REGISTRY,
} from '@portfolio-engine/editorial-theme';

interface FeatureRow {
  name: string;
  status: 'shipped' | 'optional' | 'experimental';
  description: string;
  docUrl: string;
}

const features: FeatureRow[] = [
  {
    name: 'Theme routes',
    status: 'shipped',
    description: `${DEFAULT_ROUTE_REGISTRY.length} routes injected by editorialTheme() — home, about, work (+detail), writing (+detail), contact, résumé.`,
    docUrl: 'https://github.com/rainonej/portfolio-engine/blob/main/docs/downstream/route-ownership.md',
  },
  {
    name: 'Consumer-local routes',
    status: 'shipped',
    description: 'Add pages the theme doesn\'t know about via src/pages-local/ + portfolio-engine.registry.json. Collision-checked against theme routes.',
    docUrl: 'https://github.com/rainonej/portfolio-engine/blob/main/docs/downstream/custom-page-via-registry.md',
  },
  {
    name: 'Named override surfaces',
    status: 'shipped',
    description: `${DEFAULT_OVERRIDE_SURFACES.length} surfaces with typed prop contracts. Trying to override anything else is a build-time error.`,
    docUrl: 'https://github.com/rainonej/portfolio-engine/blob/main/docs/downstream/consumption.md',
  },
  {
    name: 'Style overrides',
    status: 'shipped',
    description: 'CSS files passed to overrides.styles are appended after global.css so consumer styles always win.',
    docUrl: 'https://github.com/rainonej/portfolio-engine/blob/main/docs/downstream/design-tokens-and-theme.md',
  },
  {
    name: 'Design tokens (theme.json)',
    status: 'shipped',
    description: 'Semantic colors and typography in one JSON file. Resolved into CSS custom properties; Google Fonts wired automatically.',
    docUrl: 'https://github.com/rainonej/portfolio-engine/blob/main/docs/downstream/design-tokens-and-theme.md',
  },
  {
    name: 'IframeEmbed',
    status: 'shipped',
    description: 'Security-vetted iframe wrapper: HTTPS-only or same-origin paths, optional host allowlist, typed sandbox / allow / referrerpolicy.',
    docUrl: 'https://github.com/rainonej/portfolio-engine/blob/main/docs/downstream/iframe-embeds-and-demos.md',
  },
  {
    name: 'SchedulingBlock',
    status: 'shipped',
    description: 'Provider-light scheduling component (Calendly, Cal, Google Calendar, Microsoft Bookings, custom) with button / link / embed modes.',
    docUrl: 'https://github.com/rainonej/portfolio-engine/blob/main/docs/downstream/scheduling-calendly.md',
  },
  {
    name: 'Admin tools',
    status: 'optional',
    description: '/admin dashboard + GitHub OAuth + Contents-API writes. Or devBypass: true for local-only direct-to-disk writes.',
    docUrl: 'https://github.com/rainonej/portfolio-engine/tree/main/packages/admin-tools',
  },
  {
    name: 'Setup-with-Claude flow',
    status: 'shipped',
    description: 'Paste docs/downstream/setup-with-claude.md into Claude Code. Numbered phase scripts with DRY_RUN and SKIP_* flags.',
    docUrl: 'https://github.com/rainonej/portfolio-engine/blob/main/docs/downstream/setup-with-claude.md',
  },
  {
    name: 'One-click upgrade',
    status: 'shipped',
    description: 'VS Code task + shell script that pins every @portfolio-engine/* package to @latest in lockstep.',
    docUrl: 'https://github.com/rainonej/portfolio-engine/blob/main/docs/downstream/upgrade-path.md',
  },
  {
    name: 'Manifest + doctor CLI',
    status: 'shipped',
    description: '.portfolio-engine/manifest.json emitted every build. `pnpm pe:doctor` inspects route origins, override status, and theme version.',
    docUrl: 'https://github.com/rainonej/portfolio-engine/tree/main/packages/engine-core',
  },
  {
    name: 'workflow-kit',
    status: 'experimental',
    description: 'Scaffold-only. Planned: GitHub Actions classifier + reusable workflow templates routing consumer changes upstream.',
    docUrl: 'https://github.com/rainonej/portfolio-engine/tree/main/packages/workflow-kit',
  },
];

const statusStyles: Record<FeatureRow['status'], string> = {
  shipped:
    'bg-[color-mix(in_srgb,var(--color-accent-primary)_15%,transparent)] text-[var(--color-accent-primary)]',
  optional:
    'bg-[var(--color-surface-wash)] text-[var(--color-text-muted)] border border-[var(--color-border-default)]',
  experimental:
    'bg-[color-mix(in_srgb,var(--color-accent-secondary)_20%,transparent)] text-[var(--color-accent-secondary)]',
};
---

<Layout
  title="Features — portfolio-engine"
  description="Everything portfolio-engine ships, in one table. Routes, overrides, theme components, admin, tooling — with links to the docs."
>
  <main class="mx-auto max-w-5xl px-6 pb-24 pt-40">
    <p
      class="mb-3 font-mono text-[11px] uppercase tracking-[0.2em] text-[var(--color-accent-primary)]"
    >
      Consumer-local route · src/pages-local/features.astro
    </p>
    <h1 class="mb-6 font-serif text-5xl font-bold leading-tight">
      Feature matrix
    </h1>
    <p class="mb-12 max-w-3xl text-xl leading-relaxed text-[var(--color-text-muted)]">
      Everything portfolio-engine ships today, in one table. The "Theme
      routes" and "Named override surfaces" rows read their counts at build
      time from <code class="rounded bg-[var(--color-surface-wash)] px-1.5 py-0.5 font-mono text-sm">DEFAULT_ROUTE_REGISTRY</code>
      and <code class="rounded bg-[var(--color-surface-wash)] px-1.5 py-0.5 font-mono text-sm">DEFAULT_OVERRIDE_SURFACES</code>
      exported from <code class="rounded bg-[var(--color-surface-wash)] px-1.5 py-0.5 font-mono text-sm">@portfolio-engine/editorial-theme</code>,
      so this page can't drift from the theme's public surface.
    </p>

    <div class="overflow-hidden rounded-2xl border border-[var(--color-border-default)] bg-[var(--color-surface-page)]">
      <table class="w-full border-collapse text-left text-sm">
        <caption class="sr-only">
          Live capability matrix for portfolio-engine: each row lists a
          feature, its current status (shipped, beta, or planned), and a
          short description. Data is read at build time from the theme's
          DEFAULT_ROUTE_REGISTRY and DEFAULT_OVERRIDE_SURFACES exports.
        </caption>
        <thead>
          <tr class="border-b border-[var(--color-border-default)] bg-[var(--color-surface-wash)]">
            <th class="px-5 py-4 font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--color-accent-primary)]">
              Feature
            </th>
            <th class="px-5 py-4 font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--color-accent-primary)]">
              Status
            </th>
            <th class="px-5 py-4 font-mono text-[11px] uppercase tracking-[0.18em] text-[var(--color-accent-primary)]">
              What it does
            </th>
          </tr>
        </thead>
        <tbody>
          {features.map((feature, index) => (
            <tr
              class={
                index < features.length - 1
                  ? 'border-b border-[var(--color-border-default)]'
                  : ''
              }
            >
              <td class="px-5 py-4 align-top font-serif text-base font-semibold text-[var(--color-text-primary)]">
                <a
                  href={feature.docUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="underline underline-offset-4 transition-colors hover:text-[var(--color-accent-primary)]"
                >
                  {feature.name}
                </a>
              </td>
              <td class="px-5 py-4 align-top">
                <span
                  class={`inline-flex items-center rounded-full px-2.5 py-0.5 font-mono text-[10px] uppercase tracking-[0.12em] ${statusStyles[feature.status]}`}
                >
                  {feature.status}
                </span>
              </td>
              <td class="px-5 py-4 align-top text-[var(--color-text-muted)]">
                {feature.description}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <section class="mt-16">
      <h2 class="mb-4 font-mono text-[11px] uppercase tracking-[0.2em] text-[var(--color-accent-primary)]">
        Live registry data
      </h2>
      <h3 class="mb-6 font-serif text-3xl font-bold">
        What the theme actually declares
      </h3>
      <div class="grid gap-6 md:grid-cols-2">
        <div
          class="rounded-2xl border border-[var(--color-border-default)] bg-[var(--color-surface-wash)] p-6"
        >
          <p class="mb-2 font-mono text-[10px] uppercase tracking-[0.18em] text-[var(--color-text-muted)]">
            DEFAULT_ROUTE_REGISTRY
          </p>
          <ul class="space-y-1 font-mono text-sm">
            {DEFAULT_ROUTE_REGISTRY.map((route) => (
              <li class="flex items-baseline justify-between gap-4">
                <span class="text-[var(--color-text-primary)]">
                  {route.pattern}
                </span>
                <span class="text-xs text-[var(--color-text-muted)]">
                  {route.visibility}
                </span>
              </li>
            ))}
          </ul>
        </div>
        <div
          class="rounded-2xl border border-[var(--color-border-default)] bg-[var(--color-surface-wash)] p-6"
        >
          <p class="mb-2 font-mono text-[10px] uppercase tracking-[0.18em] text-[var(--color-text-muted)]">
            DEFAULT_OVERRIDE_SURFACES
          </p>
          <ul class="space-y-2 font-mono text-sm">
            {DEFAULT_OVERRIDE_SURFACES.map((surface) => (
              <li>
                <span class="text-[var(--color-text-primary)]">
                  {surface.name}
                </span>
                <span class="ml-2 text-xs text-[var(--color-text-muted)]">
                  ({surface.props.join(', ')})
                </span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <aside data-pe-feature-callout class="mt-12">
      <strong>Demo note</strong>
      This page imports <code>DEFAULT_ROUTE_REGISTRY</code> and
      <code>DEFAULT_OVERRIDE_SURFACES</code> directly from
      <code>@portfolio-engine/editorial-theme</code>. If the theme ships a
      new override surface in a future release, this list updates on the
      next build — no manual edits needed.
    </aside>
  </main>
</Layout>

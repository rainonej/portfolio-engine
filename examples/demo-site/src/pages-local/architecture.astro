---
// Consumer-local route — declared in src/registry/portfolio-engine.registry.json.
// Thin host: loads page copy from content/pages/architecture.yaml.
// All rendering, IframeEmbed usage, and layout are in ArchitectureTemplate.
import { getEntry } from 'astro:content';
import { getBase } from '@portfolio-engine/editorial-theme';
import ArchitectureTemplate from '../templates/ArchitectureTemplate.astro';

const pageEntry = await getEntry('pages', 'architecture');
if (!pageEntry) throw new Error('architecture.astro: pages/architecture.yaml is required.');

const base = getBase();
---

<ArchitectureTemplate page={pageEntry.data} featuresHref={`${base}/features`} />

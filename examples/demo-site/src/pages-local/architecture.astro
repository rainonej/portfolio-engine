---
/**
 * Consumer-local route — declared in src/registry/portfolio-engine.registry.json.
 *
 * Demonstrates: a consumer-local page using a theme-shipped component
 * (`IframeEmbed` from @portfolio-engine/editorial-theme/components/IframeEmbed.astro)
 * to render a same-origin static interactive demo from public/.
 */
import Layout from '@portfolio-engine/editorial-theme/layouts/Layout.astro';
import IframeEmbed from '@portfolio-engine/editorial-theme/components/IframeEmbed.astro';
import { getBase, resolveAssetUrl } from '@portfolio-engine/editorial-theme';

const base = getBase();
// resolveAssetUrl only returns null for null/empty input, so passing a
// non-empty literal here is guaranteed to return a string.
const diagramSrc = resolveAssetUrl(
  '/assets/demos/architecture/',
  base,
) as string;
---

<Layout
  title="Architecture — portfolio-engine"
  description="The four-layer architecture in detail, with an interactive same-origin diagram embedded via the theme's IframeEmbed component."
>
  <main class="mx-auto max-w-4xl px-6 pb-24 pt-40">
    <p
      class="mb-3 font-mono text-[11px] uppercase tracking-[0.2em] text-[var(--color-accent-primary)]"
    >
      Consumer-local route · src/pages-local/architecture.astro
    </p>
    <h1 class="mb-6 font-serif text-5xl font-bold leading-tight">
      Architecture
    </h1>
    <p class="mb-12 text-xl leading-relaxed text-[var(--color-text-muted)]">
      portfolio-engine is split into four packages, each one a strict
      downward dependency. The interactive diagram below renders the layers
      and their direct dependencies — click a layer to see what it does and
      what it depends on.
    </p>

    <section class="mb-16">
      <h2 class="mb-4 font-serif text-3xl font-bold">
        Layers, interactive
      </h2>
      <p class="mb-6 text-base leading-relaxed text-[var(--color-text-muted)]">
        This diagram is a self-contained HTML file under
        <code class="rounded bg-[var(--color-surface-wash)] px-1.5 py-0.5 font-mono text-sm">public/assets/demos/architecture/</code>,
        embedded via the theme's <code class="rounded bg-[var(--color-surface-wash)] px-1.5 py-0.5 font-mono text-sm">&lt;IframeEmbed&gt;</code>
        component. Same-origin so the host allowlist doesn't apply; sandboxed
        to <code class="rounded bg-[var(--color-surface-wash)] px-1.5 py-0.5 font-mono text-sm">allow-scripts</code>
        only, no cookies or storage shared.
      </p>

      <IframeEmbed
        src={diagramSrc}
        title="Four-layer architecture diagram — click any layer to highlight its dependency"
        height={620}
        loading="lazy"
        sandbox="allow-scripts"
        caption="Same-origin static demo, rendered through the theme's typed IframeEmbed wrapper. The component rejects http://, javascript:, data:, protocol-relative, and control-character src values at build time."
      />
    </section>

    <section class="mb-16">
      <h2 class="mb-4 font-serif text-3xl font-bold">The layers, in words</h2>
      <dl class="space-y-8">
        <div>
          <dt class="mb-1 font-mono text-[11px] uppercase tracking-[0.2em] text-[var(--color-accent-primary)]">
            Layer 01
          </dt>
          <dd>
            <h3 class="mb-2 font-serif text-xl font-semibold">
              @portfolio-engine/schema
            </h3>
            <p class="text-base leading-relaxed text-[var(--color-text-muted)]">
              Pure Zod schemas. No Astro, no Vite, no framework dependency.
              The canonical shape of every config file, content entry, and
              registry record. Ships as a leaf package so every other layer
              can depend on it cleanly.
            </p>
          </dd>
        </div>
        <div>
          <dt class="mb-1 font-mono text-[11px] uppercase tracking-[0.2em] text-[var(--color-accent-primary)]">
            Layer 02
          </dt>
          <dd>
            <h3 class="mb-2 font-serif text-xl font-semibold">
              @portfolio-engine/engine-core
            </h3>
            <p class="text-base leading-relaxed text-[var(--color-text-muted)]">
              The Astro integration. Loads JSON config, validates against the
              schema package, exposes virtual modules
              (<code class="rounded bg-[var(--color-surface-wash)] px-1.5 py-0.5 font-mono text-sm">@portfolio-engine:config</code>,
              <code class="rounded bg-[var(--color-surface-wash)] px-1.5 py-0.5 font-mono text-sm">:context</code>,
              <code class="rounded bg-[var(--color-surface-wash)] px-1.5 py-0.5 font-mono text-sm">:routes</code>,
              <code class="rounded bg-[var(--color-surface-wash)] px-1.5 py-0.5 font-mono text-sm">:overrides</code>),
              discovers routes, and writes <code class="rounded bg-[var(--color-surface-wash)] px-1.5 py-0.5 font-mono text-sm">.portfolio-engine/manifest.json</code>
              on build. Consumers never import this directly.
            </p>
          </dd>
        </div>
        <div>
          <dt class="mb-1 font-mono text-[11px] uppercase tracking-[0.2em] text-[var(--color-accent-primary)]">
            Layer 03
          </dt>
          <dd>
            <h3 class="mb-2 font-serif text-xl font-semibold">
              @portfolio-engine/editorial-theme
            </h3>
            <p class="text-base leading-relaxed text-[var(--color-text-muted)]">
              The first-party theme. Owns layouts, components, the global
              stylesheet, and the five named override surfaces. Exports
              <code class="rounded bg-[var(--color-surface-wash)] px-1.5 py-0.5 font-mono text-sm">editorialTheme()</code>
              — the single Astro integration that wraps engine-core and
              configures Tailwind v4 via PostCSS.
            </p>
          </dd>
        </div>
        <div>
          <dt class="mb-1 font-mono text-[11px] uppercase tracking-[0.2em] text-[var(--color-accent-primary)]">
            Layer 04
          </dt>
          <dd>
            <h3 class="mb-2 font-serif text-xl font-semibold">
              Your consumer site
            </h3>
            <p class="text-base leading-relaxed text-[var(--color-text-muted)]">
              Private repo. Holds <code class="rounded bg-[var(--color-surface-wash)] px-1.5 py-0.5 font-mono text-sm">src/config/*.json</code>,
              <code class="rounded bg-[var(--color-surface-wash)] px-1.5 py-0.5 font-mono text-sm">src/content/**</code>,
              <code class="rounded bg-[var(--color-surface-wash)] px-1.5 py-0.5 font-mono text-sm">src/overrides/</code>,
              and optionally <code class="rounded bg-[var(--color-surface-wash)] px-1.5 py-0.5 font-mono text-sm">src/pages-local/</code>
              + <code class="rounded bg-[var(--color-surface-wash)] px-1.5 py-0.5 font-mono text-sm">src/registry/</code>.
              Depends on the editorial theme via the published npm package.
              Never on engine-core or schema directly.
            </p>
          </dd>
        </div>
      </dl>
    </section>

    <aside data-pe-feature-callout>
      <strong>Demo note</strong>
      This page is rendered from
      <code>src/pages-local/architecture.astro</code> via the consumer
      registry. The interactive diagram is loaded by the theme's
      <code>IframeEmbed</code> component — a typed wrapper around
      <code>&lt;iframe&gt;</code> with HTTPS validation, an optional host
      allowlist, and rejection of <code>javascript:</code>,
      <code>data:</code>, protocol-relative, and control-character URLs.
    </aside>

    <section class="mt-12">
      <p class="text-base leading-relaxed text-[var(--color-text-muted)]">
        For the live route registry and override-surface contract — read
        directly from <code>@portfolio-engine/editorial-theme</code> at build
        time — see the
        <a
          href={`${base}/features`}
          class="text-[var(--color-accent-primary)] underline underline-offset-4 transition-colors hover:text-[var(--color-text-primary)]"
        >
          feature matrix
        </a>.
      </p>
    </section>
  </main>
</Layout>

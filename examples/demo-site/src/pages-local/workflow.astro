---
/**
 * Consumer-local route — declared in src/registry/portfolio-engine.registry.json.
 *
 * Documents the agent-safe workflow: how site-owner needs become scoped
 * issues, which work is appropriate for AI agents vs humans, and how visual
 * QA, package boundaries, and CI keep AI-assisted implementation reviewable.
 */
import Layout from '@portfolio-engine/editorial-theme/layouts/Layout.astro';

const REPO_URL = 'https://github.com/rainonej/portfolio-engine';
const ISSUES_URL = `${REPO_URL}/issues`;

interface Lane {
  eyebrow: string;
  heading: string;
  body: string;
  examples: string[];
}

const lanes: Lane[] = [
  {
    eyebrow: 'Lane 01',
    heading: 'Site-owner work',
    body: "Describe a recurring website need. You don't need to propose code. The most useful issues capture the user need, examples from real downstream sites, acceptance criteria, and whether the feature should be reusable in the engine or stay site-specific.",
    examples: [
      'Issue templates for site needs',
      'Examples from downstream consumers',
      'Acceptance criteria written in plain English',
      'Reuse questions (engine vs site-specific)',
    ],
  },
  {
    eyebrow: 'Lane 02',
    heading: 'Simple agent tasks',
    body: 'Scoped, single-package changes against typed contracts. Good fits for an AI coding agent working from the public docs and AGENTS.md. The engine and consumer boundaries make the blast radius obvious before code is written.',
    examples: [
      'Add a new theme component with declared props',
      'Wire a new config field through schema → engine-core → theme',
      'Document an existing override surface',
      'Write a content-collection migration',
    ],
  },
  {
    eyebrow: 'Lane 03',
    heading: 'Agentic automation',
    body: 'Multi-step workflows that read repository state, propose patches, and report back. The workflow-kit package is the scaffolding. Today: experimental. Tomorrow: routing consumer changes upstream when they look reusable.',
    examples: [
      'Classify a consumer change as reusable vs site-specific',
      'Open an upstream PR when criteria are met',
      'Generate a release-note draft from CHANGELOG entries',
      'Compare manifest snapshots across PRs',
    ],
  },
  {
    eyebrow: 'Lane 04',
    heading: 'Human-only decisions',
    body: 'License, governance, breaking API changes, security-sensitive surfaces, accessibility regressions, and anything where the right call depends on context an agent does not have. These get reviewed by a maintainer, not auto-merged.',
    examples: [
      'Schema-breaking changes',
      'New override surfaces and prop contracts',
      'Auth, OAuth, and admin-tools surfaces',
      'Accessibility review of generated markup',
    ],
  },
];
---

<Layout
  title="Workflow — Portfolio Engine"
  description="The agent-safe contribution workflow: site-owner needs → scoped issues → human or AI implementation → review on the shared foundation."
>
  <main class="mx-auto max-w-4xl px-6 pb-24 pt-40">
    <p
      class="mb-3 font-mono text-[11px] uppercase tracking-[0.2em] text-[var(--color-accent-primary)]"
    >
      Consumer-local route · src/pages-local/workflow.astro
    </p>
    <h1 class="mb-6 font-serif text-5xl font-bold leading-tight">
      Workflow
    </h1>
    <p class="mb-12 max-w-3xl text-xl leading-relaxed text-[var(--color-text-muted)]">
      Portfolio Engine is built around a contribution flow that is honest
      about what AI coding agents are good at and where humans still own the
      call. Site owners contribute needs. Scoped issues route work to the
      right lane. The shared engine improves on every cycle.
    </p>

    <section class="mb-16">
      <h2
        class="mb-2 font-mono text-[11px] uppercase tracking-[0.2em] text-[var(--color-accent-primary)]"
      >
        Four lanes
      </h2>
      <h3 class="mb-8 font-serif text-3xl font-bold">
        Where each kind of contribution lives
      </h3>
      <ol class="space-y-8">
        {lanes.map((lane) => (
          <li class="rounded-2xl border border-[var(--color-border-default)] bg-[var(--color-surface-wash)] p-6">
            <p class="mb-2 font-mono text-[11px] uppercase tracking-[0.2em] text-[var(--color-accent-primary)]">
              {lane.eyebrow}
            </p>
            <h4 class="mb-3 font-serif text-2xl font-semibold leading-tight">
              {lane.heading}
            </h4>
            <p class="mb-4 text-base leading-relaxed text-[var(--color-text-muted)]">
              {lane.body}
            </p>
            <ul class="grid gap-1 text-sm text-[var(--color-text-muted)] sm:grid-cols-2">
              {lane.examples.map((example) => (
                <li class="flex gap-2 before:content-['—'] before:text-[var(--color-accent-primary)]">
                  <span>{example}</span>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ol>
    </section>

    <section class="mb-16">
      <h2
        class="mb-2 font-mono text-[11px] uppercase tracking-[0.2em] text-[var(--color-accent-primary)]"
      >
        What keeps it safe
      </h2>
      <h3 class="mb-8 font-serif text-3xl font-bold">
        Guardrails on every lane
      </h3>
      <dl class="space-y-6">
        <div>
          <dt class="mb-1 font-serif text-xl font-semibold">Typed contracts</dt>
          <dd class="text-base leading-relaxed text-[var(--color-text-muted)]">
            Config, content, route registries, and override surfaces are
            validated through shared schemas at build time. A misconfigured
            change fails with a path-pointing error before it ships.
          </dd>
        </div>
        <div>
          <dt class="mb-1 font-serif text-xl font-semibold">Package boundaries</dt>
          <dd class="text-base leading-relaxed text-[var(--color-text-muted)]">
            schema → engine-core → editorial-theme → consumer. Dependencies
            only point downward. Reviewers can read the dependency direction
            and know what a change can and cannot affect.
          </dd>
        </div>
        <div>
          <dt class="mb-1 font-serif text-xl font-semibold">Issue labels</dt>
          <dd class="text-base leading-relaxed text-[var(--color-text-muted)]">
            Labels distinguish site-owner work, simple agent tasks, agentic
            automation, and human-only decisions, so the same backlog stays
            legible to humans and to agents reading from public docs.
          </dd>
        </div>
        <div>
          <dt class="mb-1 font-serif text-xl font-semibold">Visual QA and CI</dt>
          <dd class="text-base leading-relaxed text-[var(--color-text-muted)]">
            CI enforces the no-public/-in-engine-packages rule, the layered
            dependency direction, and schema validation on every commit. Visual
            QA loops cover the rendered output that types alone cannot describe.
          </dd>
        </div>
      </dl>
    </section>

    <section>
      <h2
        class="mb-2 font-mono text-[11px] uppercase tracking-[0.2em] text-[var(--color-accent-primary)]"
      >
        Start here
      </h2>
      <h3 class="mb-8 font-serif text-3xl font-bold">
        Pick the lane that fits the work
      </h3>
      <div class="flex flex-col gap-3 sm:flex-row sm:gap-4">
        <a
          href={ISSUES_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full bg-[var(--color-text-primary)] px-6 py-3 text-sm font-medium text-[var(--color-text-inverse)] transition-colors hover:bg-[var(--color-text-muted)]"
        >
          Open an issue
          <span aria-hidden="true">↗</span>
        </a>
        <a
          href={`${REPO_URL}/issues?q=is%3Aissue+is%3Aopen+label%3A%22good+first+issue%22`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full border border-[var(--color-border-default)] px-6 py-3 text-sm font-medium text-[var(--color-text-primary)] transition-colors hover:border-[var(--color-text-muted)]"
        >
          Browse good first issues
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>

    <aside data-pe-feature-callout class="mt-12">
      <strong>Demo note</strong>
      This page is a consumer-local route declared in
      <code>src/registry/portfolio-engine.registry.json</code>. The lanes
      and guardrails describe the public engine repo at
      <code>{REPO_URL}</code> — labels and templates are visible there
      without any private access.
    </aside>
  </main>
</Layout>

---
/**
 * Consumer-local replacement for the editorial-theme `/work` screen.
 *
 * The original theme route is disabled in astro.config.mjs and this file is
 * registered via src/registry/portfolio-engine.registry.json. The visible
 * banner makes it obvious in rendered HTML and visual previews that the
 * consumer-local page rendered, not the theme default.
 */
import Layout from '@portfolio-engine/editorial-theme/layouts/Layout.astro';
import ContentSectionHeader from '@portfolio-engine/editorial-theme/components/content/ContentSectionHeader.astro';
import CardGrid from '@portfolio-engine/editorial-theme/components/content/CardGrid.astro';
import FeatureCard from '@portfolio-engine/editorial-theme/components/content/FeatureCard.astro';
import { getCollection } from 'astro:content';
import { getBase, sortByDateDesc } from '@portfolio-engine/editorial-theme';

const projects = await getCollection('projects');
const sorted = sortByDateDesc(projects);
const base = getBase();
---

<Layout
  title="Work — Custom replacement"
  description="Consumer-local /work screen rendered by src/pages-local/work/index.astro."
>
  <section class="mx-auto max-w-5xl px-6 pb-24 pt-40">
    <div
      class="mb-12 rounded-2xl border p-4 text-sm"
      style="background-color: var(--color-surface-wash); border-color: var(--color-accent-primary); color: var(--color-text-primary);"
      data-pe-replacement-banner="work-list"
    >
      <strong>Custom replacement screen — example only.</strong>
      Rendered by <code>src/pages-local/work/index.astro</code>. The theme's
      default <code>/work</code> route is disabled in <code>astro.config.mjs</code>.
    </div>

    <ContentSectionHeader
      eyebrow="Demo"
      heading="Work (custom replacement)"
      description="This list comes from src/content/projects via getCollection('projects'). Cards below use the FeatureCard component from @portfolio-engine/editorial-theme/components/content."
    />

    {
      sorted.length === 0 ? (
        <p class="text-lg text-[var(--color-text-muted)]">No projects yet.</p>
      ) : (
        <CardGrid columns={2}>
          {sorted.map((project) => {
            const p = project.data;
            return (
              <FeatureCard
                title={p.title}
                description={p.description}
                href={`${base}/work/${project.id}`}
                meta={p.tags?.[0]}
                accent={p.featured}
              />
            );
          })}
        </CardGrid>
      )
    }
  </section>
</Layout>

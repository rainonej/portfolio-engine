{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Promote dev → main",
      "detail": "dev→main PR, CI, merge, workflow_dispatch Release, then verifies npm versions match origin/main (fails with diagnostics on mismatch)",
      "type": "shell",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "GIT_TERMINAL_PROMPT": "0"
        }
      },
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/scripts/promote-dev-to-main.ps1"
        ]
      },
      "linux": {
        "command": "bash",
        "args": ["${workspaceFolder}/scripts/promote-dev-to-main.sh"]
      },
      "osx": {
        "command": "bash",
        "args": ["${workspaceFolder}/scripts/promote-dev-to-main.sh"]
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      }
    }
  ]
}
